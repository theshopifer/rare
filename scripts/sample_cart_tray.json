{"shop-cart-tray":"<div id=\"shopify-section-shop-cart-tray\" class=\"shopify-section\"><link href=\"//aspire-demo-2.myshopify.com/cdn/shop/t/214/assets/shop-cart-tray.css?v=92837535659501388501789974294\" rel=\"stylesheet\" type=\"text/css\" media=\"all\" />\n\n<shop-cart-drawer>\n  <div\n    class=\"drawer-wrapper main_drawer shop-cart-drawer-shell shop-cart-drawer color-scheme-1\"\n    id=\"cart-drawer\"\n    inert\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"MY CART\"\n  >\n    <div class=\"drawer-wrapper_inner shop-cart-drawer__panel\" data-lenis-prevent>\n      \n        <header class=\"drawer_header shop-cart-drawer__header\">\n          <div>\n            <h4 class=\"h6\">MY CART </h4>\n          </div>\n          <div class=\"sc_drawer_close\">\n\n          <shop-cart-drawer-close>\n            <button class=\"theme-drawer__close\" aria-label=\"Close\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\">\r\n<path d=\"M15 1.5L13.5 0L7.5 6L1.5 0L0 1.5L6 7.5L0 13.5L1.5 15L7.5 9L13.5 15L15 13.5L9 7.5L15 1.5Z\" fill=\"#252525\"/>\r\n</svg>\n            </button>\n          </shop-cart-drawer-close>\n          </div>\n        </header>\n\n        <div class=\"sc_empty_body\">\n          <h4 class=\"h6\">My cart is currently empty.</h4>\n          <div class=\"sc_empty_action\">\n            <a class=\"btn\" aria-label=\"Continue shopping\" href=\"/collections/all\">\n              <span class=\"atc_text btn-txt\">Continue shopping</span>\n            </a>\n          </div>\n        </div>\n\n      \n    </div>\n  </div>\n</shop-cart-drawer>\n\n<script\n  defer\n>\n  const SCD_FREE_SHIP_MIN = Number(5000);\n  const SCD_BASE_CUR = \"USD\";\n  const SCD_ACTIVE_CUR = \"USD\";\n  const SCD_SPEND_LABEL = \"Spend\";\n  const SCD_MORE_LABEL = \" more for Free Shipping\";\n  const SCD_DONE_LABEL = \"Congratulations! You qualify for free delivery\";\n\n  function scdRate(cartCurrency) {\n    if (!cartCurrency || cartCurrency === SCD_BASE_CUR) return 1;\n\n    if (window.Shopify?.currency?.active === cartCurrency && Number(window.Shopify.currency.rate) > 0) {\n      return Number(window.Shopify.currency.rate);\n    }\n\n    return Number(window.Shopify?.currency?.rate) > 0 ? Number(window.Shopify.currency.rate) : 1;\n  }\n\n  function scdFormat(amountInMajorUnits, currencyCode) {\n    const amount = Number(amountInMajorUnits) || 0;\n\n    try {\n      return new Intl.NumberFormat(document.documentElement.lang || undefined, {\n        style: 'currency',\n        currency: currencyCode || SCD_ACTIVE_CUR || SCD_BASE_CUR\n      }).format(amount);\n    } catch (error) {\n      return Shopify.formatMoney(Math.round(amount * 100));\n    }\n  }\n\n  function scdUpdateBar(totalPriceInCents = 0, cartCurrency = SCD_ACTIVE_CUR) {\n    const drawer = document.querySelector('.shop-cart-drawer-shell');\n    if (!drawer) return;\n\n    const shippingMsg = drawer.querySelector('.shop-cart-shipping__message p');\n    const bar = drawer.querySelector('.shop-cart-shipping__meter-fill');\n    const wrapper = drawer.querySelector('.shop-cart-shipping[data-shop-cart-shipping-bar]');\n    if (!shippingMsg || !bar || !wrapper) return;\n\n    const rate = scdRate(cartCurrency);\n    const thresholdInCents = Math.round(SCD_FREE_SHIP_MIN * rate * 100);\n    const normalizedTotal = Number(totalPriceInCents) || 0;\n    const remainingInCents = thresholdInCents - normalizedTotal;\n    const percentage = thresholdInCents > 0\n      ? Math.min((normalizedTotal / thresholdInCents) * 100, 100)\n      : 0;\n\n    if (remainingInCents > 0) {\n      shippingMsg.textContent = `${SCD_SPEND_LABEL} ${scdFormat(remainingInCents / 100, cartCurrency)} ${SCD_MORE_LABEL}`;\n    } else {\n      shippingMsg.textContent = SCD_DONE_LABEL;\n    }\n\n    bar.style.setProperty('--width', `${percentage}%`);\n    wrapper.classList.remove('active');\n    requestAnimationFrame(() => {\n      wrapper.classList.add('active');\n    });\n\n    if (percentage >= 100) {\n      wrapper.classList.add('sc-ship-done');\n    } else {\n      wrapper.classList.remove('sc-ship-done');\n    }\n  }\n\n  function scdRefreshBar(cartData) {\n    if (cartData && typeof cartData.total_price === 'number') {\n      scdUpdateBar(cartData.total_price, cartData.currency || SCD_ACTIVE_CUR);\n      return;\n    }\n\n    fetch('/cart.js')\n      .then((res) => res.json())\n      .then((cart) => {\n        scdUpdateBar(cart.total_price, cart.currency || SCD_ACTIVE_CUR);\n      })\n      .catch(() => {\n        scdUpdateBar(0, SCD_ACTIVE_CUR);\n      });\n  }\n\n  document.addEventListener('DOMContentLoaded', () => scdRefreshBar());\n  document.addEventListener('cart-update', (e) => {\n    requestAnimationFrame(() => {\n      scdRefreshBar(e.detail);\n    });\n  });\n</script>\n\n</div>"}